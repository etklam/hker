# Copy for local use; do not commit real values. Runtime only, never Docker build args.
HKER_ENVIRONMENT=local
POSTGRES_DB=hker_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-local-password
HKER_DEV_DB_PORT=5432
HKER_DEV_WEB_PORT=3000
DATABASE_URL=postgres://postgres:replace-with-a-random-local-password@127.0.0.1:5432/hker_local
APP_BASE_URL=http://127.0.0.1:3000
AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_SESSION_COOKIE_NAME=hker_session
AUTH_SESSION_TTL_DAYS=30
DATABASE_POOL_MAX=20
# Keep false unless an ingress overwrites x-real-ip and blocks direct origin access.
TRUST_PROXY_HEADERS=false
TELEGRAM_DELIVERY_MODE=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TEST_CHAT_ID=
# Durable Bot delivery bounds. Defaults shown here match the runtime defaults.
BOT_LEASE_SECONDS=120
BOT_MAX_ATTEMPTS=6
BOT_MAX_AGE_SECONDS=86400
BOT_RETRY_BASE_MS=1000
BOT_RETRY_MAX_MS=300000
BOT_RETRY_JITTER_RATIO=0.2

# Best-effort catalog demand measurements; false keeps discovery working without collection.
DIRECTORY_ANALYTICS_ENABLED=true
# Optional separate HMAC key; otherwise existing AUTH_SESSION_SECRET is used.
# ANALYTICS_ACTION_SECRET=
